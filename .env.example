# cp .env.example .env && $EDITOR .env
#
# The SEC requires a descriptive User-Agent carrying a real contact email.
# There is no default — seeding fails loudly without it, which is correct.
SEC_USER_AGENT=FilingDesk/0.2 (you@example.com)

# Your own notes, used for FRAMING only — never for figures. Every number in
# an answer still has to come from a filing and survive the grounding guard.
# Any directory of .md files works; index it with:
#   python -c "from filingdesk import vault, config; vault.index(config.VAULT_DIR)"
FD_VAULT_DIR=/home/nick/brain
FD_VAULT_HOST=/home/nick/brain

# ---------------------------------------------------------------------------
# The model. The dashboard needs none of this — charts, figures and provenance
# work with no model at all. This is only for the narrated answers at /ask.
# ---------------------------------------------------------------------------

# "ollama" (default) runs locally: nothing leaves the machine, but a 7B model
# wants ~5GB of RAM.
FD_LLM_PROVIDER=ollama
FD_CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M
FD_EMBED_MODEL=nomic-embed-text

# --- or: any OpenAI-compatible endpoint --------------------------------------
# Runs a far larger open-weights model than local RAM allows. The tradeoff is
# real and worth stating: the question and the retrieved figures leave this
# machine, so "no network call at request time" stops being true. The
# grounding guarantee is unaffected — the guard runs locally against locally
# retrieved facts, so a hosted model still cannot introduce a number that is
# not in a filing.
#
# A self-hosted LiteLLM/vLLM proxy on the LAN — same wire format as a hosted
# provider, but the traffic never leaves the network:
# FD_LLM_PROVIDER=openai
# FD_LLM_BASE_URL=https://litellm.example.internal/v1
# FD_LLM_API_KEY=sk-...
# FD_CHAT_MODEL=gpt-oss-120b
# FD_EMBED_MODEL=
#
# Embeddings are optional and only power the notes vault. An endpoint that
# serves chat but not /embeddings (LiteLLM in front of vLLM returns 501) is
# fine: leave FD_EMBED_MODEL empty and answers continue without notes.
#
# Fireworks:
# FD_LLM_PROVIDER=openai
# FD_LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# FD_LLM_API_KEY=fw_...
# FD_CHAT_MODEL=accounts/fireworks/models/deepseek-v4-pro
# FD_EMBED_MODEL=accounts/fireworks/models/qwen3-embedding-8b
#
# How hard the model thinks before answering. Measured on the eval suite:
# medium 14/15 at 31s median, low 12/15 at 14s. Faster is genuinely sloppier —
# at "low" the draft rewrites 64.78 as 0.6478. Empty sends nothing, for
# endpoints that reject the parameter.
# FD_REASONING_EFFORT=medium
# FD_PLAN_REASONING_EFFORT=medium   # planning calls only, defaults to the above
#
# Hosted catalogues change faster than any default in this file. Confirm what
# your account can actually see, and that the configured model answers:
#   python -m filingdesk.models
#   python -m filingdesk.models --check
#
# Together:    FD_LLM_BASE_URL=https://api.together.xyz/v1
# Groq:        FD_LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter:  FD_LLM_BASE_URL=https://openrouter.ai/api/v1
# vLLM/local:  FD_LLM_BASE_URL=http://localhost:8000/v1   (no key needed)
#
# The chat model MUST support tool calling — the agent selects its own data
# tools. Instruct-tuned models generally do; base models do not.
