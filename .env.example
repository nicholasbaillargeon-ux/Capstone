# cp .env.example .env && $EDITOR .env
#
# The SEC requires a descriptive User-Agent carrying a real contact email.
# There is no default — seeding fails loudly without it, which is correct.
SEC_USER_AGENT=FilingDesk/0.2 (you@example.com)

# Your own notes, used for FRAMING only — never for figures. Every number in
# an answer still has to come from a filing and survive the grounding guard.
# Any directory of .md files works; index it with:
#   python -c "from filingdesk import vault, config; vault.index(config.VAULT_DIR)"
FD_VAULT_DIR=/home/nick/brain
FD_VAULT_HOST=/home/nick/brain

# ---------------------------------------------------------------------------
# The model. The dashboard needs none of this — charts, figures and provenance
# work with no model at all. This is only for the narrated answers at /ask.
#
# One endpoint, OpenAI-compatible. It defaults to the homelab LiteLLM proxy in
# front of gpt-oss-120b, so on this network the only thing that has to be set
# is the key. There is no local-inference path: Ollama on the app host bought a
# 7B model where the proxy serves a 120B one.
# ---------------------------------------------------------------------------

FD_LLM_API_KEY=

# Point it somewhere else — vLLM, llama.cpp's server, LM Studio, a hosted API —
# and then name a model THAT endpoint serves. There is no default off the
# default endpoint, because a guessed ID is a confident 404 from inside the
# tool-calling loop rather than an error anyone can read.
#   python -m filingdesk.models          # what does this key see?
#   python -m filingdesk.models --check  # is FD_CHAT_MODEL real and reachable?
# FD_LLM_BASE_URL=https://litellm.baillargeon.casa/v1
#
# Containers use the tailnet name instead — they resolve MagicDNS but not the
# LAN's internal .casa zone. Both compose files already default to it:
#   FD_LLM_BASE_URL=https://litellm.end-toad.ts.net/v1
# FD_CHAT_MODEL=gpt-oss-120b
#
# Leave FD_CHAT_MODEL empty for dashboard-only. That is a supported posture,
# not a broken one: /ask says so plainly and every chart carries on.
#
# Embeddings index the vault for the retrieval lane. Empty means the endpoint
# serves chat only and notes are simply not retrieved — which is the case on
# the default proxy. Changing it changes vector width and invalidates the
# index on disk, so re-index after switching.
# FD_EMBED_MODEL=
#
# How hard the model thinks before answering. Measured on the eval suite:
# medium 14/15 at 31s median, low 12/15 at 14s. Faster is genuinely sloppier —
# at "low" the draft rewrites 64.78 as 0.6478. Empty sends nothing, for
# endpoints that reject the parameter.
# FD_REASONING_EFFORT=medium
# FD_PLAN_REASONING_EFFORT=medium   # planning calls only, defaults to the above
#
# Three more latency knobs, all defaulted to what the eval suite measured. See
# docs/FINDINGS.md for the runs behind each.
#
# End the planning loop as soon as a tool has produced facts, instead of making
# one more call to hear the model say it wants nothing else. A third off the
# median question. Set to 0 if you add a question that needs a second round of
# tool calls chosen after seeing the first round's results.
# FD_STOP_ON_FIRST_FACTS=1
#
# Stream the draft as it is written. Costs nothing and changes no total; it
# changes when the first word appears. An endpoint that will not stream falls
# back by itself, so this is for turning the progressive display off on
# purpose, not for compatibility.
# FD_STREAM_DRAFT=1
#
# Cap how many facts the draft prompt carries. 0 is all of them and is right on
# any endpoint with a normal context window: prefill here costs 41 ms, and
# capping it cost a passing case and produced one confidently wrong answer.
# Raise off 0 only if a small context window forces it.
# FD_DRAFT_FACTS_MAX=0
#
# The chat model MUST support tool calling — the agent selects its own data
# tools. Instruct-tuned models generally do; base models do not.

# ---------------------------------------------------------------------------
# Serving this behind a reverse proxy, under a path rather than a host.
# ---------------------------------------------------------------------------
#
# The prefix this instance is mounted at. The proxy strips it before the
# request arrives, so routing is unchanged; what this fixes is the URLs the
# pages emit — /static/app.css, /app, /ask, the SSE stream — which would
# otherwise resolve against the proxy's root.
# FD_BASE_PATH=/filing-desk
#
# Where the "← Showcase" link on the landing page goes. Defaults to "/" when
# FD_BASE_PATH is set, on the reasoning that something else owns the root
# there. Set it to "" to drop the link, or to any URL to point it elsewhere.
# FD_SHOWCASE_URL=/
